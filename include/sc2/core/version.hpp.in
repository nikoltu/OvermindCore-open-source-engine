inline constexpr const char* kVersion = "v@PROJECT_VERSION@.@SC2_ENGINE_BUILD@-@SC2_ENGINE_STAGE@";
inline constexpr int kVersionMajor = @PROJECT_VERSION_MAJOR@;
inline constexpr int kVersionMinor = @PROJECT_VERSION_MINOR@;
inline constexpr int kVersionPatch = @PROJECT_VERSION_PATCH@;
inline constexpr const char* kVersionBuild = "@SC2_ENGINE_BUILD@";
inline constexpr const char* kVersionStage = "@SC2_ENGINE_STAGE@";

}  // namespace sc2
